  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "Pages are fetched and embedded sequentially, one at a time (extension.ts:149-167, embeddingsEngine.ts:72-88)",
        "Sitemap URLs are kept only if they start with the configured URL (discoveryEngine.ts:49)",
        "The first embedBatch downloads the MiniLM model from Hugging Face (embeddingsEngine.ts:26)"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure handling",
      "items": [
        "A page that fails or has under 50 chars of text is skipped (scraperEngine.ts:36-39)",
        "Zero scraped pages throws; status becomes 'error' and an error toast is shown (extension.ts:172-175, 242-246)",
        "Chunks whose embedding failed are dropped before storage (extension.ts:210-221)"
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence",
      "items": [
        "sql.js keeps the DB in memory; save() writes the whole file every 100 chunks and on status updates (storageEngine.ts:115-117, 321)",
        "Re-indexing deletes the library's chunks and embeddings first (storageEngine.ts:262-274)"
      ]
    }
  ]
